# ============================================================================
# NAP Service (.env.example)
# ============================================================================
# Copy to nap/.env

NODE_ENV=development
PORT=3000

# Supabase / Prisma (Prisma loads nap/.env from this directory)
# Transaction pooler (serverless-friendly; Prisma: often disable prepared statements or use adapter)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Prisma migrate/db push needs directUrl. db.*:5432 is IPv6-only by default → P1001 on many IPv4 networks.
# Use Session pooler instead (Connect → Session): same aws-* pooler host, port 5432, user postgres.<ref>
SUPABASE_DB_DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Service auth
NAP_SERVICE_TOKEN=replace-with-a-long-random-token

# Public URL of this NAP deployment (custom domain). If unset, VERCEL_URL is used on Vercel.
# NAP_PUBLIC_BASE_URL=https://your-app.vercel.app

# UI → agent proxies (production: HTTPS URLs from Railway)
SDR_BASE_URL=http://localhost:8010
CRM_CLERK_BASE_URL=http://localhost:8011
FINANCE_ANALYST_BASE_URL=http://localhost:8012

# Optional vault/KMS wiring (future hardening)
NAP_VAULT_PROVIDER=supabase-vault
NAP_VAULT_KEY_REF=

# Optional telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
